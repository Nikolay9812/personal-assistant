{
  "name": "personal-assistant",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/instrument.ts src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --import ./dist/instrument.js dist/index.js",
    "webhook:set": "tsx --env-file-if-exists=.env src/scripts/set-webhook.ts",
    "daytona:hello": "tsx --env-file-if-exists=.env src/scripts/daytona-hello.ts",
    "trigger:dev": "trigger dev",
    "db:push": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.118",
    "@daytona/sdk": "^0.231.1",
    "@hono/node-server": "^2.1.3",
    "@mendable/firecrawl-js": "^4.54.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neondatabase/serverless": "^1.2.1",
    "@sentry/node": "^11.12.0",
    "@trigger.dev/sdk": "4.8.5",
    "ai": "^7.0.170",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/cli": "^1.0.0-rc.9",
    "@sentry/esbuild-plugin": "^11.12.0",
    "@trigger.dev/build": "4.8.5",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
