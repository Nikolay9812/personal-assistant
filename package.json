{
  "name": "personal-assistant",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "webhook:set": "tsx --env-file-if-exists=.env src/scripts/set-webhook.ts",
    "trigger:dev": "trigger dev"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.118",
    "@hono/node-server": "^2.1.3",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@trigger.dev/sdk": "4.8.5",
    "ai": "^7.0.170",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@hono/cli": "^1.0.0-rc.9",
    "@trigger.dev/build": "4.8.5",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
